        "interfaces": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "enum": [
              "http",
              "https",
              "ssh",
              "ubus",
              "modem_manager",
              "documented_modem"
            ]
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "required": [
        "integratedModem",
        "manufacturers",
        "models",
        "interfaces",
        "notes"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "dns": {
          "type": "object",
          "properties": {
            "assessment": {
              "const": "UNKNOWN"
            },
            "reason": {
              "type": "string",
              "maxLength": 1024
            },
            "requirements": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "enum": [
                  "READY_FOR_FUTURE_ADAPTER",
                  "REQUIRES_AUTHENTICATION",
                  "REQUIRES_PACKAGE",
                  "REQUIRES_FIRMWARE_BUILD",
                  "REQUIRES_MANUAL_VERIFICATION",
                  "NOT_IMPLEMENTED",
                  "UNAVAILABLE",
                  "EXPERIMENTAL"
                ]
              }
            },
            "evidenceSources": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "maxLength": 1024
              }
            },
            "subCapabilities": {
              "type": "object",
              "maxProperties": 64,
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "assessment": {
                    "const": "UNKNOWN"
                  },
                  "reason": {
                    "type": "string",
                    "maxLength": 1024
                  },
                  "evidenceSources": {
                    "type": "array",
                    "maxItems": 64,
                    "items": {
                      "type": "string",
                      "maxLength": 1024
                    }
                  }
                },
                "required": [
                  "assessment",
                  "reason",
                  "evidenceSources"
                ],
                "additionalProperties": false
              }
            },
            "verifiedRange": {
              "type": "null"
            }
          },
          "required": [
            "assessment",
            "reason",
            "requirements",
            "evidenceSources",
            "subCapabilities",
            "verifiedRange"
          ],
          "additionalProperties": false
        },
