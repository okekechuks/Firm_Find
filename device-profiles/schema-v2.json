{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "inspectionOnly": {
      "const": true
    },
    "profileId": {
      "type": "string",
      "maxLength": 1024
    },
    "profileVersion": {
      "type": "string",
      "maxLength": 1024
    },
    "manufacturer": {
      "const": ""
    },
    "model": {
      "type": "string",
      "maxLength": 1024
    },
    "modelAliases": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "maxLength": 1024
      }
    },
    "deviceCategory": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "maxLength": 1024
      }
    },
    "hardwareRevisions": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string",
        "maxLength": 1024
      }
    },
    "firmwareFamilies": {
      "type": "array",
      "items": {
        "const": "OpenWrt"
      },
      "minItems": 1,
      "maxItems": 1
    },
    "firmwareVersionConstraints": {
      "type": "object",
      "properties": {
        "scheme": {
          "type": "string",
          "enum": [
            "numeric_triplet",
            "opaque_exact"
          ]
        },
        "exact": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "string",
            "maxLength": 1024
          },
          "minItems": 1
        },
        "minInclusive": {
          "type": "null"
        },
        "maxExclusive": {
          "type": "null"
        }
      },
      "required": [
        "exact",
        "minInclusive",
        "maxExclusive"
      ],
      "additionalProperties": false
    },
    "matchRules": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "attribute": {
            "type": "string",
            "enum": [
              "manufacturer",
              "model",
              "hardware_revision",
              "firmware_family",
              "firmware_version",
              "usb_vid",
              "usb_pid",
              "usb_product",
              "physical_identity",
              "management_identity",
              "modem_manufacturer",
              "modem_model",
              "windows_manufacturer",
              "gateway",
              "user_label",
              "http_status",
              "wireless_driver",
              "reported_identifier"
            ]
          },
          "values": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 1024
            }
          },
          "purpose": {
            "type": "string",
            "enum": [
              "identity",
              "corroboration",
              "candidate_hint"
            ]
          },
          "explanation": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "required": [
          "attribute",
          "values",
          "purpose",
          "explanation"
        ],
        "additionalProperties": false
      }
    },
    "managementInterfaces": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "protocol": {
            "type": "string",
            "enum": [
              "http",
              "https",
              "ssh",
              "ubus",
              "modem_manager",
              "documented_modem"
            ]
          },
          "authenticationRequired": {
            "type": "boolean"
          },
          "firmwareFamilies": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 1024
            }
          },
          "operations": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 1024
            }
          },
          "security": {
            "type": "string",
            "maxLength": 1024
          },
          "limitations": {
            "type": "string",
            "maxLength": 1024
          },
          "evidenceSources": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 1024
            }
          }
        },
        "required": [
          "protocol",
          "authenticationRequired",
          "firmwareFamilies",
          "operations",
          "security",
          "limitations",
          "evidenceSources"
        ],
        "additionalProperties": false
      }
    },
    "modemInformation": {
      "type": "object",
      "properties": {
        "integratedModem": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "manufacturers": {
          "type": "array",
          "maxItems": 64,
