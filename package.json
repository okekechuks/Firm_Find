{
  "name": "obtainer-workspace",
  "private": true,
  "version": "0.2.0-beta.2",
  "type": "module",
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "test:universal-workflow-native": "node scripts/verify-foundation.mjs --universal-workflow",
    "test:dns-build": "python -B scripts/test-dns-build.py",
    "test:catalogue": "python scripts/refresh-official-catalogue.py --upstream apps/desktop/src-tauri/assets/official --check",
    "test:official-acquisition": "node scripts/verify-foundation.mjs --official-acquisition",
    "test:library-upgrade": "node scripts/verify-foundation.mjs --stage3-upgrade",
    "dev:simulator": "node scripts/dev-simulator.mjs",
    "test:simulator": "node scripts/verify-foundation.mjs --phase4 --phase4-1 --gui --phase5 --phase6",
    "test:openwrt": "node scripts/verify-foundation.mjs --phase4 --phase4-1 --gui --phase5 --phase6 --phase7",
    "dev": "npm run dev --workspace @obtainer/desktop",
    "build": "npm run build --workspace @obtainer/desktop",
    "preview": "npm run preview --workspace @obtainer/desktop",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test --workspace @obtainer/desktop",
    "test:native": "node scripts/native-smoke.mjs",
    "test:foundation": "node scripts/verify-foundation.mjs",
    "build:native-tests": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native-tests.ps1",
    "tauri": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1",
    "test:gui": "node scripts/verify-foundation.mjs --phase4 --phase4-1 --gui",
    "test:extraction-worker": "python -B scripts/test-firmware-extraction.py",
    "test:extraction-v2": "python -B scripts/test-extraction-engine-v2.py",
    "test:extraction-native": "node scripts/verify-foundation.mjs --official-acquisition --firmware-extraction",
    "test:extraction-review-native": "node scripts/verify-foundation.mjs --official-acquisition --firmware-extraction --extraction-review"
  }
}
