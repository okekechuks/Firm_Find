{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window may read workspace state, save preferences and request passive device inventory.",
  "windows": ["main"],
  "platforms": ["windows"],
  "permissions": ["allow-get-snapshot", "allow-save-settings", "allow-get-discovery", "allow-refresh-discovery", "core:event:allow-listen", "core:event:allow-unlisten"]
}
