{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window may read workspace state, save preferences and request passive device inventory.",
  "windows": [
    "main"
  ],
  "platforms": [
    "windows"
  ],
  "permissions": [
    "allow-select-firmware-file","allow-discard-firmware-selection","allow-start-firmware-import","allow-list-firmware-artifacts","allow-get-firmware-artifact","allow-verify-firmware-integrity","allow-cancel-library-job","allow-list-library-jobs","allow-get-library-job","allow-get-library-activity","allow-export-artifact-manifest",
    "allow-get-snapshot",
    "allow-save-settings",
    "allow-get-discovery",
    "allow-refresh-discovery",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-manual-routers",
    "allow-add-manual-router",
    "allow-remove-manual-router",
    "allow-probe-management-endpoint",
    "allow-cancel-endpoint-probe",
    "allow-cancel-discovery",
    "allow-get-profile-registry",
    "allow-get-device-compatibility",
    "allow-validate-device-profile",
    "allow-record-device-observation"
  ]
}
