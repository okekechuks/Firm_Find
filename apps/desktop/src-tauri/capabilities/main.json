{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local desktop workspace may discover devices, manage selected firmware copies and backups, review history and persist preferences. No device write command.",
  "windows": [
    "main"
  ],
  "platforms": [
    "windows"
  ],
  "permissions": [
    "allow-list-official-sources",
    "allow-start-official-download",
    "allow-get-official-provenance",
    "allow-start-firmware-analysis",
    "allow-get-firmware-analysis",
    "allow-approve-firmware-route-probe",
    "allow-approve-static-menu",
    "allow-approve-auth-challenge",
    "allow-read-auth-challenge",
    "allow-read-static-menu",
    "allow-discover-firmware-routes",
    "allow-cancel-firmware-route-discovery",
    "allow-export-acquisition-diagnostics",
    "allow-openwrt-status",
    "allow-openwrt-observe",
    "allow-openwrt-connect",
    "allow-openwrt-approve-reads",
    "allow-openwrt-inspect",
    "allow-openwrt-cancel",
    "allow-openwrt-disconnect",
    "allow-get-desktop-state",
    "allow-save-desktop-preferences",
    "allow-list-firmware-backups",
    "allow-create-firmware-backup",
    "allow-restore-firmware-backup",
    "allow-remove-firmware-item",
    "allow-open-managed-folder",
    "allow-select-library-directory",
    "allow-relocate-firmware-library",
    "allow-recover-default-library",
    "allow-select-firmware-file",
    "allow-discard-firmware-selection",
    "allow-start-firmware-import",
    "allow-list-firmware-artifacts",
    "allow-get-firmware-artifact",
    "allow-list-firmware-import-history",
    "allow-verify-firmware-integrity",
    "allow-cancel-library-job",
    "allow-list-library-jobs",
    "allow-get-library-job",
    "allow-get-library-activity",
    "allow-export-artifact-manifest",
    "allow-get-snapshot",
    "allow-save-settings",
    "allow-get-discovery",
    "allow-refresh-discovery",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-manual-routers",
    "allow-add-manual-router",
    "allow-remove-manual-router",
    "allow-probe-management-endpoint",
    "allow-cancel-endpoint-probe",
    "allow-cancel-discovery",
    "allow-get-profile-registry",
    "allow-list-available-adapters",
    "allow-get-device-adapter-matches",
    "allow-get-device-compatibility",
    "allow-validate-device-profile",
    "allow-record-device-observation"
  ]
}
